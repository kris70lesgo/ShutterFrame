# ShutterFrame server → local TrueForge. This is safe to expose only as a URL,
# never use NEXT_PUBLIC_ for secrets.
TRUEFORGE_BASE_URL=http://localhost:8790

# Server-side Neon PostgreSQL connection. Never expose with NEXT_PUBLIC_.
DATABASE_URL=

# TrueForge owns the Groq model-provider configuration. Never expose this to
# browser-side JavaScript.
GROQ_API_KEY=

# Neon development project only. Never point these at production credentials.
NEON_API_KEY=
NEON_PROJECT_ID=

# GitHub MCP / integration configuration. Configure the token in TrueForge.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
# Required by the intake route. Generate a long random value per environment.
SHUTTERFRAME_INTAKE_TOKEN=
# PR used by `pnpm verify:github-intake`; this can also be passed as an argument.
GITHUB_INTAKE_PR_NUMBER=

# Daytona is configured by TrueForge for sandbox execution.
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
