# ShutterFrame server → local TrueForge. This is safe to expose only as a URL,
# never use NEXT_PUBLIC_ for secrets.
TRUEFORGE_BASE_URL=http://127.0.0.1:8790

# TrueForge owns model-provider configuration. Set this in TrueForge's local
# settings or environment, not in browser code.
OPENAI_API_KEY=

# Neon development project only. Never point these at production credentials.
NEON_API_KEY=
NEON_PROJECT_ID=

# GitHub MCP / integration configuration. Configure the token in TrueForge.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# Daytona is configured by TrueForge for sandbox execution.
DAYTONA_API_KEY=
